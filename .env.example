FLASK_APP=app.py
FLASK_ENV=production

# IMPORTANT: SECRET_KEY must be set to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-key

DATABASE_URL=postgresql://postgres:your-password@localhost:5432/rehabdb

# Telegram bot (used by bot_webhook.py and app notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id

# Webhook settings (for bot_webhook.py). Use an HTTPS URL (e.g. via ngrok or your domain).
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# Groq API key (used by helpers/ai_generator.py for SMM content generation)
GROQ_API_KEY=your-groq-api-key

# Yandex SmartCaptcha (used by app.py contact form)
# Client key (public, starts with ysc1_) — used in frontend widget
YANDEX_SMARTCAPTCHA_CLIENT_KEY=ysc1_your-client-key
# Server key (secret, starts with ysc2_) — used for backend validation
YANDEX_SMARTCAPTCHA_SERVER_KEY=ysc2_your-server-key

# Bot notify webhook (used by app.py to send Telegram notifications through the bot,
# bypassing Telegram API blocking). Must match NOTIFY_SECRET in bot's .env
BOT_NOTIFY_URL=https://bot.your-domain.com/notify
NOTIFY_SECRET=your-secret-for-bot-notify

# Optional: Flask debug mode (0 or 1)
FLASK_DEBUG=0

# Optional: server port for app.py
PORT=5000
